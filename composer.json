{
    "name": "rmie/sistema-rutas",
    "description": "Sistema de Gestión de Rutas y Entregas RMIE",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "RMIE Team",
            "email": "dev@rmie.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "RMIE\\Controllers\\": "app/controllers/",
            "RMIE\\Models\\": "app/models/",
            "RMIE\\Utils\\": "app/utils/",
            "RMIE\\Config\\": "config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RMIE\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 app/",
        "cs-fix": "phpcbf --standard=PSR12 app/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}